<% content_for :title, "Roles" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Roles</h1>
    <%= link_to "New role", new_role_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="roles" class="min-w-full divide-y divide-gray-200 space-y-5">
    <table class="min-w-full divide-y divide-gray-200 table-fixed w-full overflow-hidden rounded-2xl shadow-lg">
      <thead class="bg-gray-50">
      <tr class="text-left">
        <th class="py-3.5 px-4">Role</th>
        <th class="py-3.5 px-4">Description</th>
        <th class="py-3.5 px-4">Actions</th>
      </tr>
      </thead>
      <% if @roles.any? %>
        <% @roles.each do |role| %>
          <tbody class="bg-white divide-y divide-gray-200">
          <tr class="text-left hover:bg-gray-50 cursor-pointer">
            <td class="py-4 px-4"><%= role.name %></td>
            <td class="py-4 px-4"><%= role.description %></td>
            <td class="py-4 px-4">
              <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
                <%= link_to "Show", role, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
                <%= link_to "Edit", edit_role_path(role), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
                <%= button_to "Destroy", role, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
              </div>
            </td>
          </tr>
          </tbody>
        <% end %>
      <% else %>
    </table>
      <p class="text-center my-10">No roles found.</p>
    <% end %>
  </div>
</div>
