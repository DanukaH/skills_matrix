<% content_for :title, "Showing role" %>

<div class="md:w-2/3 w-full mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Skill: <%= @role.name %></h1>

  <div class="mt-8 rounded-2xl bg-white p-8 shadow-lg space-y-5 min-w-full">
    <p class="mt-4 text-slate-200">
      <div id="<%= dom_id @role %>" class="w-full sm:w-auto my-5 space-y-5">
        <table class="w-full">
          <tr>
            <td class="w-1/4">
              <strong class="block font-medium mb-1">Skill name</strong>
            </td>
            <td class="w-3/4">
              <%= @role.name %>
            </td>
          </tr>
          <tr>
            <td class="w-1/4">
              <strong class="block font-medium mb-1">Description</strong>
            </td>
            <td class="w-3/4">
              <%= @role.description %>
            </td>
          </tr>
        </table>
      </div>
    </p>
  </div>

  <div class="mt-8 float-right">
    <%= link_to "Edit", edit_role_path(@role), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= link_to "Back", roles_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= button_to "Delete", @role, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
