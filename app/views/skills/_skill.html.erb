<div id="<%= dom_id skill %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Skill name:</strong>
    <%= skill.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Level:</strong>
    <%= skill.level %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Years of experience:</strong>
    <%= skill.years_of_experience %>
  </div>
</div>
